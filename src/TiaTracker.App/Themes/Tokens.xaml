<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Token del tema scuro: superfici a strati, testo, un accento e i toni
        semantici degli stati. Ogni tono ha tre pennelli: Bg (fondo del chip,
        trasparente), Fg (testo sul fondo) e Solid (pallino, barra, bordo).
        Nessun colore va scritto direttamente nelle viste: si usano queste chiavi.
    -->

    <!-- Superfici -->
    <SolidColorBrush x:Key="WindowBrush" Color="#121418" />
    <SolidColorBrush x:Key="AppBarBrush" Color="#181B21" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#15181D" />
    <SolidColorBrush x:Key="CardBrush" Color="#1D2129" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#252A34" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2C313C" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#333B82F6" />

    <!-- Testo -->
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A3ACB9" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#6B7380" />

    <!-- Accento e semantici (nomi storici mantenuti) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B97F8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

    <!-- Toni (vedi Core.Domain.Tone) -->
    <SolidColorBrush x:Key="Tone.Neutral.Bg" Color="#2E94A3B8" />
    <SolidColorBrush x:Key="Tone.Neutral.Fg" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Tone.Neutral.Solid" Color="#94A3B8" />

    <SolidColorBrush x:Key="Tone.Accent.Bg" Color="#3D3B82F6" />
    <SolidColorBrush x:Key="Tone.Accent.Fg" Color="#A5C8FF" />
    <SolidColorBrush x:Key="Tone.Accent.Solid" Color="#3B82F6" />

    <SolidColorBrush x:Key="Tone.Success.Bg" Color="#3322C55E" />
    <SolidColorBrush x:Key="Tone.Success.Fg" Color="#86EFAC" />
    <SolidColorBrush x:Key="Tone.Success.Solid" Color="#22C55E" />

    <SolidColorBrush x:Key="Tone.Warning.Bg" Color="#38F59E0B" />
    <SolidColorBrush x:Key="Tone.Warning.Fg" Color="#FCD34D" />
    <SolidColorBrush x:Key="Tone.Warning.Solid" Color="#F59E0B" />

    <SolidColorBrush x:Key="Tone.Danger.Bg" Color="#38EF4444" />
    <SolidColorBrush x:Key="Tone.Danger.Fg" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Tone.Danger.Solid" Color="#EF4444" />

    <SolidColorBrush x:Key="Tone.Purple.Bg" Color="#38A78BFA" />
    <SolidColorBrush x:Key="Tone.Purple.Fg" Color="#D4C6FF" />
    <SolidColorBrush x:Key="Tone.Purple.Solid" Color="#A78BFA" />

    <SolidColorBrush x:Key="Tone.Orange.Bg" Color="#38F97316" />
    <SolidColorBrush x:Key="Tone.Orange.Fg" Color="#FDBA74" />
    <SolidColorBrush x:Key="Tone.Orange.Solid" Color="#F97316" />

    <SolidColorBrush x:Key="Tone.Teal.Bg" Color="#3314B8A6" />
    <SolidColorBrush x:Key="Tone.Teal.Fg" Color="#7EEBDD" />
    <SolidColorBrush x:Key="Tone.Teal.Solid" Color="#14B8A6" />

    <SolidColorBrush x:Key="Tone.Muted.Bg" Color="#1F64748B" />
    <SolidColorBrush x:Key="Tone.Muted.Fg" Color="#94A3B8" />
    <SolidColorBrush x:Key="Tone.Muted.Solid" Color="#64748B" />

    <!-- Diff (confronto affiancato) -->
    <SolidColorBrush x:Key="DiffChangedBrush" Color="#33F59E0B" />
    <SolidColorBrush x:Key="DiffDeletedBrush" Color="#38EF4444" />
    <SolidColorBrush x:Key="DiffInsertedBrush" Color="#3322C55E" />

    <!-- Misure -->
    <sys:Double x:Key="RowHeight">30</sys:Double>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <Thickness x:Key="CardPadding">16,12</Thickness>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
