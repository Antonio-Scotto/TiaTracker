<Window x:Class="TiaTracker.App.Views.PronetaImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TiaTracker.App.Controls"
        Title="Importa da PRONETA" Width="1180" Height="720" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}">
    <DockPanel Margin="18,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                       Text="Le righe abbinate (per nome PROFINET, poi IP, poi MAC) ricevono il MAC e i campi vuoti; un IP diverso dalla tabella non si cambia ma si segnala. I dispositivi solo in rete si aggiungono come righe PRONETA." />
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Seleziona tutto" Click="OnAll" Margin="0,0,6,0" />
                <Button Content="Solo abbinati" Click="OnMatchedOnly" Margin="0,0,6,0" />
                <Button Content="Nessuno" Click="OnNone" Margin="0,0,18,0" />
                <TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Importa" Click="OnOk" IsDefault="True" MinWidth="120" Margin="0,0,8,0" Style="{StaticResource AccentButton}"
                    ui:Ui.Glyph="{StaticResource Icon.Import}" />
            <Button Content="Annulla" IsCancel="True" Width="100" />
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Apply, UpdateSourceTrigger=PropertyChanged}" Width="36" MinWidth="36" />
                <DataGridTemplateColumn Header="Esito" Width="210" MinWidth="210" SortMemberPath="Outcome">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Outcome}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IpDiffers}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Tone.Warning.Fg}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="New">
                                                <Setter Property="Foreground" Value="{StaticResource Tone.Teal.Fg}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nome PROFINET" Binding="{Binding Device.Name}" Width="1.4*" MinWidth="220" IsReadOnly="True" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Device.DeviceType}" Width="*" MinWidth="150" IsReadOnly="True" />
                <DataGridTextColumn Header="IP in rete" Binding="{Binding Device.Ip}" Width="120" MinWidth="120" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" />
                <DataGridTextColumn Header="IP in tabella" Binding="{Binding TableIp}" Width="120" MinWidth="120" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" />
                <DataGridTextColumn Header="MAC" Binding="{Binding Device.Mac}" Width="140" MinWidth="140" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" />
                <DataGridTextColumn Header="IO controller" Binding="{Binding Device.IoController}" Width="*" MinWidth="160" IsReadOnly="True" />
                <DataGridTextColumn Header="Ruolo" Binding="{Binding Device.Role}" Width="90" MinWidth="90" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
