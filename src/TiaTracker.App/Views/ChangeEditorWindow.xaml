<Window x:Class="TiaTracker.App.Views.ChangeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TiaTracker.App.Controls"
        Title="{Binding WindowTitle}" Width="1000" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}"
        FocusManager.FocusedElement="{Binding ElementName=TitleBox}">
    <!-- Ctrl+S salva come dice la finestra: una bozza resta bozza (il segno si toglie solo con "Convalida e salva"). -->
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>
    <DockPanel Margin="18,14,18,16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" FontSize="20" Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Bozza: "Convalida e salva" in evidenza, "Salva bozza" la lascia da convalidare. -->
            <Button Content="Convalida e salva" Command="{Binding ValidateCommand}" IsDefault="{Binding CanValidate}" MinWidth="150" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}" ui:Ui.Glyph="{StaticResource Icon.Check}"
                    Visibility="{Binding CanValidate, Converter={StaticResource BoolToVis}}" />
            <Button Content="Salva bozza" Command="{Binding SaveCommand}" MinWidth="110" Margin="0,0,8,0" ui:Ui.Glyph="{StaticResource Icon.Save}"
                    ToolTip="Salva le correzioni e la lascia da convalidare (Ctrl+S)"
                    Visibility="{Binding CanValidate, Converter={StaticResource BoolToVis}}" />
            <Button Content="Salva" Command="{Binding SaveCommand}" IsDefault="{Binding CannotValidate}" MinWidth="110" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}" ui:Ui.Glyph="{StaticResource Icon.Save}" ToolTip="Salva (Ctrl+S)"
                    Visibility="{Binding CannotValidate, Converter={StaticResource BoolToVis}}" />
            <Button Content="Annulla" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="100" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Border Background="{StaticResource Tone.Accent.Bg}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding ContentReadOnly, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Info}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Tone.Accent.Fg}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding ReadOnlyHint}" TextWrapping="Wrap" Foreground="{StaticResource Tone.Accent.Fg}" />
                    </DockPanel>
                </Border>

                <Border Background="{StaticResource Tone.Warning.Bg}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding CanValidate, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Flag}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Tone.Warning.Fg}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding DraftHint}" TextWrapping="Wrap" Foreground="{StaticResource Tone.Warning.Fg}" />
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Titolo" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TitleBox" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" FontWeight="SemiBold"
                             IsReadOnly="{Binding ContentReadOnly}" ui:Ui.Placeholder="Cosa cambia, in una riga" AutomationProperties.Name="Titolo" />

                    <TextBlock Grid.Row="1" Text="Data / ambito" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3" IsEnabled="{Binding CanEditContent}">
                        <DatePicker SelectedDate="{Binding Date}" Width="160" Margin="0,0,12,0" AutomationProperties.Name="Data" />
                        <ComboBox ItemsSource="{Binding Scopes}" SelectedIndex="{Binding ScopeIndex}" Width="130" Margin="0,0,12,0"
                                  AutomationProperties.Name="Ambito" />
                        <!-- Su una bozza da convalidare la scelta la fanno i due pulsanti: con la spunta tolta "Salva bozza" la confermava. -->
                        <CheckBox Content="Bozza (da confermare)" IsChecked="{Binding Draft}" VerticalAlignment="Center"
                                  Visibility="{Binding CannotValidate, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Descrizione" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                             IsReadOnly="{Binding ContentReadOnly}" ui:Ui.Placeholder="Cosa e' stato fatto e dove"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Descrizione" />

                    <TextBlock Grid.Row="3" Text="Motivazione" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Motivation, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                             IsReadOnly="{Binding ContentReadOnly}" ui:Ui.Placeholder="Perche': richiesta del cliente, anomalia, collaudo..."
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Motivazione" />

                    <TextBlock Grid.Row="4" Text="Estratto" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"
                               Visibility="{Binding HasExcerpt, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Excerpt, Mode=OneWay}" IsReadOnly="True" Margin="0,3"
                             TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                             Foreground="{StaticResource MutedBrush}" Visibility="{Binding HasExcerpt, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <TextBlock Text="BLOCCHI TOCCATI" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                <DockPanel Margin="0,0,0,8" Visibility="{Binding CanEditContent, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Content="Aggiungi" Command="{Binding AddBlocksCommand}" Margin="8,0,0,0"
                            ui:Ui.Glyph="{StaticResource Icon.Add}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding KnownNames}" Text="{Binding NewBlockText, UpdateSourceTrigger=PropertyChanged}"
                              IsTextSearchEnabled="True" StaysOpenOnEdit="True" AutomationProperties.Name="Nuovo blocco"
                              ToolTip="Nome di un blocco o UDT (suggeriti dall'ultimo snapshot). Si puo' incollare un elenco separato da virgole o a capo." />
                </DockPanel>
                <TextBlock Text="Nessun blocco: scriverne il nome qui sopra (si puo' incollare l'elenco di un README)." Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Blocks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Blocks}" AutomationProperties.Name="Blocchi toccati">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Togli il blocco dalla modifica"
                                            Command="{Binding DataContext.RemoveBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Togli blocco" Margin="6,0,0,0"
                                            Visibility="{Binding DataContext.CanEditContent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{StaticResource Icon.Delete}" Style="{StaticResource IconText}" />
                                    </Button>
                                    <ComboBox DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" AutomationProperties.Name="Azione"
                                              ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.CanEditContent, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBox DockPanel.Dock="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Name}"
                                             FontWeight="SemiBold" Width="300" VerticalAlignment="Center" Margin="0,0,8,0"
                                             IsReadOnly="{Binding DataContext.ContentReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             AutomationProperties.Name="Nome del blocco" />
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="Nota sul blocco"
                                             IsReadOnly="{Binding DataContext.ContentReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                             AutomationProperties.Name="Nota sul blocco" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="STATO PER VERSIONE" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                           Text="Spuntare le versioni su cui va (o e' andata) la modifica. Importata o Compilata senza Salvata = progetto NON salvato in TIA." />
                <ItemsControl ItemsSource="{Binding VersionRows}" AutomationProperties.Name="Stato per versione">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,6" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Included}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="210"
                                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource Chip}" Background="{Binding VersionStateText, Converter={StaticResource StateBrush}}"
                                                    Visibility="{Binding HasVersionState, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding VersionStateText}" FontSize="11"
                                                           Foreground="{Binding VersionStateText, Converter={StaticResource StateBrush}, ConverterParameter=Fg}" />
                                            </Border>
                                        </StackPanel>
                                    </CheckBox>
                                    <ComboBox DockPanel.Dock="Left" Width="150" Margin="0,0,16,0" AutomationProperties.Name="Stato"
                                              ItemsSource="{Binding DataContext.StateOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Option, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Included}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Errori" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox DockPanel.Dock="Left" Width="52" Margin="0,0,12,0" AutomationProperties.Name="Errori"
                                             Text="{Binding Errors, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Warning" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox DockPanel.Dock="Left" Width="52" Margin="0,0,12,0" AutomationProperties.Name="Warning"
                                             Text="{Binding Warnings, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="Nota sulla versione"
                                             AutomationProperties.Name="Nota sulla versione" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
