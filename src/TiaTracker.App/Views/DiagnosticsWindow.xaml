<Window x:Class="TiaTracker.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostica TIA Openness" Width="980" Height="820" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <Style x:Key="OkText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Found}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Found}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HelloText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HelloOk}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HelloOk}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Aggiorna" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="Copia report" Command="{Binding CopyReportCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding AppVersion}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllOk}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Chiudi" IsCancel="True" Click="OnClose" Width="100" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="WORKER OPENNESS" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Workers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Prova (hello)" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.HelloCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding Found}" Margin="8,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource OkText}" />
                                                    <TextBlock Visibility="{Binding Path, Converter={StaticResource NullToVis}}" Margin="0,2,0,0">
                                                        <Hyperlink Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding Path}">
                                                            <Run Text="{Binding Path, Mode=OneWay}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding HelloText}" Style="{StaticResource HelloText}"
                                                       Visibility="{Binding HelloText, Converter={StaticResource NullToVis}}" />
                                            <Expander Header="Percorsi controllati" Margin="0,6,0,0">
                                                <TextBox Text="{Binding SearchedText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MaxHeight="220"
                                                         VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DLL OPENNESS INSTALLATE" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Apis}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Margin="0,2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="UTENTE WINDOWS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding GroupText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GroupOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GroupOk}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Elenca istanze" Command="{Binding ListInstancesCommand}" />
                            <TextBlock Text="ISTANZE DI TIA PORTAL" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding InstancesText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <ItemsControl ItemsSource="{Binding Instances}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="IMPOSTAZIONI DI QUESTO PC" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cartella dei worker" Style="{StaticResource FieldLabel}"
                                       ToolTip="Vuoto = worker\ accanto a TiaTracker.exe (ricerca automatica)" />
                            <TextBox Grid.Column="1" Text="{Binding WorkerDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <Button Grid.Column="2" Content="Sfoglia..." Command="{Binding BrowseWorkerDirCommand}" Margin="6,2,0,2" />

                            <TextBlock Grid.Row="1" Text="Openness V21 (PublicAPI\V21\net48)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Vuoto = ricerca automatica in Programmi\Siemens" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ApiV21, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Sfoglia..." Command="{Binding BrowseApiCommand}" CommandParameter="21" Margin="6,2,0,2" />

                            <TextBlock Grid.Row="2" Text="Openness V18 (PublicAPI\V18)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Vuoto = ricerca automatica in Programmi\Siemens" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ApiV18, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Sfoglia..." Command="{Binding BrowseApiCommand}" CommandParameter="18" Margin="6,2,0,2" />
                        </Grid>
                        <Button Content="Salva impostazioni" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CARTELLE" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Programma" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding AppDir}" Style="{StaticResource FieldValue}" />
                            <Button Grid.Column="2" Content="Apri" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding AppDir}" Margin="6,2,0,2" />
                            <TextBlock Grid.Row="1" Text="Dati" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataRoot}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="Log" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogDir}" Style="{StaticResource FieldValue}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Apri" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LogDir}" Margin="6,2,0,2" />
                            <TextBlock Grid.Row="3" Text="Lavoro" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WorkDir}" Style="{StaticResource FieldValue}" />
                            <Button Grid.Row="3" Grid.Column="2" Content="Apri" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding WorkDir}" Margin="6,2,0,2" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
