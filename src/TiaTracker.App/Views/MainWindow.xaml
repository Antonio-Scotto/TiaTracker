<Window x:Class="TiaTracker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TiaTracker.App.ViewModels"
        xmlns:v="clr-namespace:TiaTracker.App.Views"
        xmlns:svc="clr-namespace:TiaTracker.App.Services"
        xmlns:ui="clr-namespace:TiaTracker.App.Controls"
        Title="TiaTracker" Icon="/Assets/TiaTracker.ico" Width="1400" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource WindowBrush}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommessaCommand}" />
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CommessaDetailViewModel}">
            <v:CommessaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionDetailViewModel}">
            <v:VersionView />
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:CommessaNode}" ItemsSource="{Binding Versions}">
            <StackPanel Margin="0,6,0,5">
                <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Commessa.Code, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding NameText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:VersionNode}">
            <DockPanel Margin="0,3">
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top"
                         Fill="{Binding MainChip, Converter={StaticResource StateBrush}, ConverterParameter=Solid}"
                         ToolTip="{Binding MainChip}" />
                <StackPanel>
                    <!-- I chip vanno a capo: la barra laterale non scorre in orizzontale. -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Notifica: barra in alto o avviso in basso a destra. -->
        <DataTemplate x:Key="NoticeTemplate" DataType="{x:Type svc:Notice}">
            <Border x:Name="Box" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderThickness="1"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                <DockPanel>
                    <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                               FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{StaticResource AccentBrush}" />
                    <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" ToolTip="Chiudi" VerticalAlignment="Top"
                            Padding="6,2" Margin="8,0,0,0" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Actions}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Text}" Command="{Binding Command}" Margin="4,0,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:NoticeKind.Success}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tone.Success.Bg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:NoticeKind.Warning}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tone.Warning.Solid}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:NoticeKind.Error}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tone.Danger.Solid}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra superiore -->
        <Border Grid.Row="0" Background="{StaticResource AppBarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,9" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Image Source="/Assets/TiaTracker.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TiaTracker" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Versioni e progetti TIA Portal" FontSize="10.5" Foreground="{StaticResource SubtleBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="Nuova commessa" Command="{Binding NewCommessaCommand}" Margin="0,0,6,0"
                        Style="{StaticResource AccentButton}" ui:Ui.Glyph="{StaticResource Icon.Add}" ToolTip="Nuova commessa (Ctrl+N)" />
                <Button DockPanel.Dock="Left" Content="Scansiona" Command="{Binding ScanCommand}" Style="{StaticResource ToolbarButton}"
                        ui:Ui.Glyph="{StaticResource Icon.Scan}"
                        ToolTip="Rilegge le cartelle della commessa selezionata (o di tutte) - F5" />
                <Button DockPanel.Dock="Left" Content="Importa storico" Command="{Binding ImportHistoryCommand}" Style="{StaticResource ToolbarButton}"
                        ui:Ui.Glyph="{StaticResource Icon.Import}"
                        ToolTip="Bozze di modifiche dai README e dai documenti della commessa" />

                <Button DockPanel.Dock="Right" Command="{Binding OpenDiagnosticsCommand}" Margin="8,0,0,0" Style="{StaticResource ToolbarButton}"
                        AutomationProperties.Name="Diagnostica"
                        ToolTip="Worker Openness, DLL di TIA, gruppo Windows, istanze aperte">
                    <StackPanel Orientation="Horizontal">
                        <Grid Margin="0,0,8,0">
                            <TextBlock Text="{StaticResource Icon.Diagnostics}" Style="{StaticResource IconText}" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-3,-4,0" Visibility="{Binding DiagnosticsProblem, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBlock Text="Diagnostica" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding DataInfo}" Margin="0,0,4,0">
                    <TextBlock Text="{StaticResource Icon.Database}" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DataShort}" FontSize="11" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barre persistenti (es. worker mancante) -->
        <ItemsControl Grid.Row="1" ItemsSource="{x:Static svc:Notify.Banners}" ItemTemplate="{StaticResource NoticeTemplate}"
                      Margin="16,10,16,0" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra laterale -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,12,8,6">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding ShowRetired}" Content="" Padding="7,4"
                                      Background="Transparent" BorderThickness="0"
                                      ui:Ui.Glyph="{StaticResource Icon.View}" AutomationProperties.Name="Mostra versioni vecchie"
                                      ToolTip="Mostra anche le versioni vecchie, archiviate e scartate" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Margin="0">
                            <Run Text="COMMESSE" />
                            <Run Text="{Binding CommesseCount, Mode=OneWay}" Foreground="{StaticResource SubtleBrush}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="14,0,10,8" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             ui:Ui.Placeholder="Filtra commesse e versioni (Ctrl+F)" AutomationProperties.Name="Filtro commesse" />
                    <TreeView x:Name="Tree" ItemsSource="{Binding Commesse}" Margin="6,0,4,8" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="OnTreeSelectionChanged" PreviewMouseRightButtonDown="OnTreeRightButtonDown"
                              ContextMenuOpening="OnTreeContextMenuOpening">
                        <!-- Segnaposto: il menu vero si costruisce in OnTreeContextMenuOpening (VersionMenu). -->
                        <TreeView.ContextMenu>
                            <ContextMenu />
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

            <ContentControl Grid.Column="2" Content="{Binding Detail}" Margin="20,16,20,12" />

            <!-- Avvisi in basso a destra -->
            <ItemsControl Grid.Column="2" ItemsSource="{x:Static svc:Notify.Toasts}" ItemTemplate="{StaticResource NoticeTemplate}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="460" Margin="0,0,24,12" Panel.ZIndex="10" />
        </Grid>

        <!-- Barra di stato -->
        <Border Grid.Row="3" Background="{StaticResource AppBarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,6" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding Job.Running, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Job.Text}" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="560" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Width="200" Height="6" Value="{Binding Job.Progress}" Maximum="1"
                                 IsIndeterminate="{Binding Job.Indeterminate}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Annulla" Command="{Binding Job.CancelCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
