<UserControl x:Class="TiaTracker.App.Views.BlocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock Text="Snapshot" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Snapshot}" DisplayMemberPath="Display" Width="380" Margin="0,0,12,0" />
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="140" Margin="0,0,8,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="Filtra per nome o gruppo" Margin="0,0,8,0" />
            <CheckBox Content="XML" IsChecked="{Binding ShowXml}" VerticalAlignment="Center" ToolTip="Mostra l'XML canonico anche quando c'e' l'SCL" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Opacity="0.65" Margin="0,0,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="85" />
                    <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="50" />
                    <DataGridTextColumn Header="Ling." Binding="{Binding Language}" Width="60" />
                    <DataGridTextColumn Header="Gruppo" Binding="{Binding Group}" Width="1.5*" />
                    <DataGridTextColumn Header="Codice mod." Binding="{Binding CodeModified}" Width="110" />
                    <DataGridTextColumn Header="Compilato" Binding="{Binding Compiled}" Width="110" />
                    <DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />
            <TextBox Grid.Column="2" Text="{Binding Source, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                     FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" />
        </Grid>
    </DockPanel>
</UserControl>
