<Window x:Class="TiaTracker.App.Views.ReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TiaTracker.App.Controls"
        Title="Conferma spostamento" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="19" TextWrapping="Wrap" />
        <TextBlock x:Name="Intro" Style="{StaticResource MutedText}" Margin="0,4,0,12" />

        <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="280" HeadersVisibility="Column" SelectionMode="Single"
                  AutomationProperties.Name="Spostamenti">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Attivita'" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource CellTextCentered}" />
                <DataGridTextColumn Header="Prima" Binding="{Binding From}" Width="150" ElementStyle="{StaticResource CellTextCentered}" />
                <DataGridTextColumn Header="Dopo" Binding="{Binding To}" Width="150" ElementStyle="{StaticResource CellTextCentered}" />
                <DataGridTextColumn Header="Spost." Binding="{Binding Shift}" Width="80" ElementStyle="{StaticResource CellTextCentered}" />
                <DataGridTextColumn Header="Origine" Binding="{Binding Origin}" Width="90" ElementStyle="{StaticResource CellTextCentered}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="ConflictsPanel" Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{StaticResource DangerBrush}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="CONFLITTI" Style="{StaticResource SectionTitle}" Foreground="{StaticResource DangerBrush}" />
                <ItemsControl x:Name="Conflicts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=": " />
                                <Run Text="{Binding Reason, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"
                           Text="Le attivita' in conflitto restano dove sono: si sistemano a mano, o togliendo la data fissata." />
            </StackPanel>
        </Border>

        <TextBlock Text="Motivo (resta nello storico delle tempistiche)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox x:Name="ReasonBox" ui:Ui.Placeholder="es. ritardo consegna quadri, richiesta del cliente, collaudo spostato"
                 AutomationProperties.Name="Motivo" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Applica" Click="OnApply" IsDefault="True" MinWidth="120" Margin="0,0,8,0" Style="{StaticResource AccentButton}"
                    ui:Ui.Glyph="{StaticResource Icon.Check}" />
            <Button Content="Annulla" IsCancel="True" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
