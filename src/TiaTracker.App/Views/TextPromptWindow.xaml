<Window x:Class="TiaTracker.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Click="OnOk" IsDefault="True" Width="100" Margin="0,0,8,0" />
            <Button Content="Annulla" IsCancel="True" Width="100" />
        </StackPanel>
    </StackPanel>
</Window>
