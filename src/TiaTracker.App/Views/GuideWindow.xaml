<Window x:Class="TiaTracker.App.Views.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guida rapida" Width="760" Height="720" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource AppBarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,10">
                <Button DockPanel.Dock="Right" Content="Chiudi" IsCancel="True" IsDefault="True" Click="OnClose" MinWidth="90" />
                <TextBlock x:Name="Footer" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" FontSize="11.5" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="28,22,28,24" />
        </ScrollViewer>
    </DockPanel>
</Window>
