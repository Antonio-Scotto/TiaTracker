<UserControl x:Class="TiaTracker.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:TiaTracker.App.Services">
    <UserControl.Resources>
        <Style x:Key="DiffCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="LineNo" TargetType="TextBlock" BasedOn="{StaticResource DiffCell}">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <WrapPanel>
                <TextBlock Text="Base" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox ItemsSource="{Binding BaseOptions}" SelectedItem="{Binding Base}" DisplayMemberPath="Display" Width="380" Margin="0,0,12,6" />
                <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding Target}" DisplayMemberPath="Display" Width="380" Margin="0,0,12,6" />
                <Button Content="Confronta" Command="{Binding RunCompareCommand}" Margin="0,0,6,6" />
                <Button Content="Nuovo snapshot e confronta" Command="{Binding SnapshotAndCompareCommand}" Margin="0,0,6,6"
                        ToolTip="Snapshot della versione (da TIA aperto se aperta, altrimenti da copia del file) e confronto con la base" />
                <Button Content="Report" Command="{Binding OpenReportCommand}" Margin="0,0,6,6"
                        ToolTip="Il report del confronto in TiaTrackerOut\Confronti" />
            </WrapPanel>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="150" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" MinWidth="250" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="190" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filtra per nome" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Stato" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Background="{Binding Status, Converter={StaticResource StateBrush}}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Nome" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="75" />
                            <DataGridTextColumn Header="Cosa" Binding="{Binding Facets}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

                <DockPanel Grid.Column="2">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <CheckBox DockPanel.Dock="Right" Content="Solo differenze" IsChecked="{Binding OnlyChanges}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DiffTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding UnitsText}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding UnitsText, Converter={StaticResource NullToVis}}" />
                    <ListView ItemsSource="{Binding DiffRows}" HorizontalContentAlignment="Stretch"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:DiffRow}">
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LeftNo}" Style="{StaticResource LineNo}" />
                                    <Border Grid.Column="1" x:Name="Left">
                                        <TextBlock Text="{Binding LeftText}" Style="{StaticResource DiffCell}" ToolTip="{Binding LeftText}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding RightNo}" Style="{StaticResource LineNo}" />
                                    <Border Grid.Column="3" x:Name="Right">
                                        <TextBlock Text="{Binding RightText}" Style="{StaticResource DiffCell}" ToolTip="{Binding RightText}" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:DiffKind.Changed}">
                                        <Setter TargetName="Left" Property="Background" Value="{StaticResource DiffChangedBrush}" />
                                        <Setter TargetName="Right" Property="Background" Value="{StaticResource DiffChangedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:DiffKind.Deleted}">
                                        <Setter TargetName="Left" Property="Background" Value="{StaticResource DiffDeletedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:DiffKind.Inserted}">
                                        <Setter TargetName="Right" Property="Background" Value="{StaticResource DiffInsertedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:DiffKind.Gap}">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <DockPanel Grid.Row="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4" LastChildFill="False">
                    <TextBlock Text="Riconciliazione" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ReconcileSummary}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Assegna a modifica..." Command="{Binding AssignCommand}" Margin="0,0,6,0"
                            ToolTip="Il blocco entra in una modifica della commessa, associata a questa versione se non lo era (le modifiche nuove si creano nella commessa)" />
                    <Button Content="Ignora" Command="{Binding IgnoreCommand}" Margin="0,0,6,0" />
                    <Button Content="Annulla decisione" Command="{Binding UndoCommand}" Margin="0,0,6,0" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Reconcile}" SelectedItem="{Binding SelectedReconcile}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Esito" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Background="{Binding Status, Converter={StaticResource StateBrush}}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Blocco" Binding="{Binding Block}" Width="1.3*" />
                            <DataGridTextColumn Header="Confronto" Binding="{Binding What}" Width="110" />
                            <DataGridTextColumn Header="Modifiche" Binding="{Binding Changes}" Width="1.5*" />
                            <DataGridTextColumn Header="Nota" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Applica" Command="{Binding ApplyProposalsCommand}" />
                            <TextBlock Text="Proposte di stato (da confermare)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Proposals}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Apply}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="360" />
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
