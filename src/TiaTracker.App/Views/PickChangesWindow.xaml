<Window x:Class="TiaTracker.App.Views.PickChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiungi modifiche esistenti" Width="760" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Aggiungi" Click="OnOk" IsDefault="True" Width="110" Margin="0,0,8,0" />
                <Button Content="Annulla" IsCancel="True" Width="100" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StateLabel" Text="Stato iniziale" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="StateBox" Width="150" />
            </StackPanel>
        </DockPanel>
        <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="0,0,0,8" TextChanged="OnFilter" ToolTip="Filtra" />
        <ListBox x:Name="List" SelectionMode="Extended">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Info}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
