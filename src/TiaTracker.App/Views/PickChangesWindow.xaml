<Window x:Class="TiaTracker.App.Views.PickChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TiaTracker.App.Controls"
        Title="Aggiungi modifiche esistenti" Width="760" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}">
    <DockPanel Margin="18,14,18,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Aggiungi" Click="OnOk" IsDefault="True" MinWidth="110" Margin="0,0,8,0" Style="{StaticResource AccentButton}"
                        ui:Ui.Glyph="{StaticResource Icon.Link}" />
                <Button Content="Annulla" IsCancel="True" Width="100" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StateLabel" Text="Stato iniziale" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <ComboBox x:Name="StateBox" Width="150" AutomationProperties.Name="Stato iniziale" />
            </StackPanel>
        </DockPanel>
        <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="0,0,0,8" TextChanged="OnFilter"
                 ui:Ui.Placeholder="Cerca fra le modifiche della commessa" AutomationProperties.Name="Cerca modifiche" />
        <ListBox x:Name="List" SelectionMode="Extended" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
