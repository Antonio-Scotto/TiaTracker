<Window x:Class="TiaTracker.App.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TiaTracker.App.Controls"
        Title="{Binding WindowTitle}" Width="780" Height="680" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}">
    <DockPanel Margin="18,14,18,16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" FontSize="20" Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Salva" Click="OnSave" IsDefault="True" MinWidth="110" Margin="8,0,8,0" Style="{StaticResource AccentButton}"
                            ui:Ui.Glyph="{StaticResource Icon.Save}" />
                    <Button Content="Annulla" IsCancel="True" MinWidth="100" />
                </StackPanel>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="Nota per lo storico (facoltativa): perche' cambia"
                         AutomationProperties.Name="Nota per lo storico" />
            </DockPanel>
        </StackPanel>

        <TabControl>
            <TabItem Header="Attivita'">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <Grid Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Titolo" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                                 AutomationProperties.Name="Titolo" />

                        <TextBlock Grid.Row="1" Text="Tipo" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,3"
                                  AutomationProperties.Name="Tipo" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Fase" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding Phases}" SelectedItem="{Binding Phase}" Margin="0,3"
                                  AutomationProperties.Name="Fase" />

                        <TextBlock Grid.Row="2" Text="Stato" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Margin="0,3"
                                  AutomationProperties.Name="Stato" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Priorita'" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" Margin="0,3"
                                  AutomationProperties.Name="Priorita" />

                        <TextBlock Grid.Row="3" Text="Inizio" Style="{StaticResource FieldLabel}" />
                        <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding StartDate}" IsEnabled="{Binding DatesEditable}" Margin="0,3"
                                    AutomationProperties.Name="Inizio" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Fine" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding IsMilestone, Converter={StaticResource InvBoolToVis}}" />
                        <DatePicker Grid.Row="3" Grid.Column="4" SelectedDate="{Binding EndDate}" IsEnabled="{Binding DatesEditable}" Margin="0,3"
                                    Visibility="{Binding IsMilestone, Converter={StaticResource InvBoolToVis}}" AutomationProperties.Name="Fine" />

                        <TextBlock Grid.Row="4" Text="Durata" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                    Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="Durata" />
                            <TextBlock Text="giorni lavorativi" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" IsChecked="{Binding Locked}" Margin="0,3" VerticalAlignment="Center"
                                  Content="Data fissata (la cascata non la sposta)" Visibility="{Binding DatesEditable, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="5" Text="Assegnatario" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" IsEditable="True" ItemsSource="{Binding AssigneeSuggestions}"
                                  Text="{Binding Assignee, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" AutomationProperties.Name="Assegnatario" />
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Versione" Style="{StaticResource FieldLabel}"
                                   ToolTip="La versione del progetto TIA su cui si fa il lavoro" />
                        <ComboBox Grid.Row="5" Grid.Column="4" ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" Margin="0,3"
                                  AutomationProperties.Name="Versione" />

                        <TextBlock Grid.Row="6" Text="Avanzamento" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}" />
                        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3" Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding Progress, Mode=OneWay}" /><Run Text="%" />
                            </TextBlock>
                            <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Progress}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Avanzamento" />
                        </DockPanel>

                        <TextBlock Grid.Row="7" Text="Ore stimate" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EstimatedHours, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="110"
                                 HorizontalAlignment="Left" AutomationProperties.Name="Ore stimate" />
                        <TextBlock Grid.Row="7" Grid.Column="3" Text="Ore consuntivo" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="7" Grid.Column="4" Text="{Binding ActualHours, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="110"
                                 HorizontalAlignment="Left" AutomationProperties.Name="Ore consuntivo" />

                        <TextBlock Grid.Row="8" Text="Descrizione" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                        <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Descrizione" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Dipendenze">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Comincia dopo la fine di queste attivita' (piu' i giorni lavorativi di ritardo, o meno se negativi). Se una slitta, questa slitta con lei." />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Aggiungi" Command="{Binding AddPredecessorCommand}" Margin="8,0,0,0"
                                ui:Ui.Glyph="{StaticResource Icon.Link}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="ritardo" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewLag, UpdateSourceTrigger=PropertyChanged}" Width="50" AutomationProperties.Name="Ritardo" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding NewPredecessor}" DisplayMemberPath="Title"
                                  AutomationProperties.Name="Nuovo predecessore" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Predecessors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Togli la dipendenza"
                                                Command="{Binding DataContext.RemovePredecessorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="Togli dipendenza">
                                            <TextBlock Text="{StaticResource Icon.Delete}" Style="{StaticResource IconText}" />
                                        </Button>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0">
                                            <TextBlock Text="ritardo" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Lag, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                            <TextBlock Text="gg" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Dates}" Style="{StaticResource MutedText}" FontSize="11.5" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="Modifiche">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                               Text="Le modifiche del registro che questa attivita' realizza. Quando e' fatta senza modifiche collegate, TiaTracker propone di registrarne una." />
                    <TextBox DockPanel.Dock="Top" Text="{Binding ChangeFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             ui:Ui.Placeholder="Cerca fra le modifiche" AutomationProperties.Name="Cerca modifiche" />
                    <ListBox ItemsSource="{Binding ChangesView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsLinked}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Info}" Style="{StaticResource MutedText}" FontSize="11.5" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="Storico">
                <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="110" ElementStyle="{StaticResource CellTextCentered}" />
                        <DataGridTextColumn Header="Chi" Binding="{Binding User}" Width="80" ElementStyle="{StaticResource CellTextCentered}" />
                        <DataGridTextColumn Header="Cosa" Binding="{Binding What}" Width="110" ElementStyle="{StaticResource CellTextCentered}" />
                        <DataGridTextColumn Header="Da" Binding="{Binding From}" Width="*" ElementStyle="{StaticResource CellTextCentered}" />
                        <DataGridTextColumn Header="A" Binding="{Binding To}" Width="*" ElementStyle="{StaticResource CellTextCentered}" />
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CellTextCentered}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
