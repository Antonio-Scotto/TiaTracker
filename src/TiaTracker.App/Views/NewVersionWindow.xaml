<Window x:Class="TiaTracker.App.Views.NewVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuova versione da questa" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}">
    <StackPanel Margin="18">
        <TextBlock x:Name="Header" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="Nome della nuova versione (cartella e file progetto)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Margin="0,2,0,10" FontWeight="SemiBold" TextChanged="OnNameChanged" />
        <CheckBox x:Name="CarryBox" Content="Portare nella nuova versione le modifiche gia' Salvate in quella di partenza" IsChecked="True" Margin="0,0,0,6" />
        <CheckBox x:Name="ActiveBox" Content="La nuova versione e' In lavoro" IsChecked="True" Margin="0,0,0,6" />
        <CheckBox x:Name="SourceOldBox" Margin="0,0,0,6" ToolTip="Si lavora sulla copia: la versione di partenza esce dal lavoro corrente" />
        <Border x:Name="OpenWarning" Style="{StaticResource Card}" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                       Text="La versione di partenza e' aperta in TIA: si copia l'ultimo salvataggio. Le modifiche non salvate NON passano nella copia: salvare in TIA prima di procedere." />
        </Border>
        <TextBlock x:Name="Error" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Crea" Click="OnOk" IsDefault="True" Width="110" Margin="0,0,8,0" Style="{StaticResource AccentButton}" />
            <Button Content="Annulla" IsCancel="True" Width="100" />
        </StackPanel>
    </StackPanel>
</Window>
