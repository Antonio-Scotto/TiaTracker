<Window x:Class="TiaTracker.App.Views.LoadedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TiaTracker.App.Controls"
        Title="Caricata sul PLC" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Nessun file dice cosa c'e' sul PLC: si registra qui quando si carica. La versione caricata finora sugli stessi PLC diventa Vecchia."
                   Style="{StaticResource MutedText}" Margin="0,4,0,14" />

        <TextBlock Text="PLC" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
        <ItemsControl x:Name="PlcList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding Now, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,6,0,0">
            <TextBlock Text="Altro PLC" Style="{StaticResource FieldLabel}" Width="90" />
            <TextBox x:Name="OtherPlc" ui:Ui.Placeholder="Nome di un altro PLC (es. PLC_1, plc_linea2)" />
        </DockPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Quando" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                <DatePicker x:Name="DateBox" Width="170" Margin="0,0,8,0" />
                <TextBox x:Name="TimeBox" Width="80" ToolTip="Ora (hh:mm)" />
                <Button Content="Adesso" Click="OnNow" Margin="8,0,0,0" ui:Ui.Glyph="{StaticResource Icon.Clock}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Nota" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,4" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" Margin="0,4"
                     ui:Ui.Placeholder="Facoltativa (es. messa in servizio, caricato da...)" />
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12,8">
            <StackPanel>
                <CheckBox x:Name="ProofBox" Content="Fai subito uno snapshot di prova dal TIA aperto" />
                <TextBlock x:Name="ProofHint" Style="{StaticResource MutedText}" FontSize="11.5" Margin="26,2,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Segna caricata" Click="OnOk" IsDefault="True" MinWidth="130" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}" ui:Ui.Glyph="{StaticResource Icon.Check}" />
            <Button Content="Annulla" IsCancel="True" Width="100" />
        </StackPanel>
    </StackPanel>
</Window>
