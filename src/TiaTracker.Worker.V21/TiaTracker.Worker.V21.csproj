<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Worker per TIA Portal V19..V21: Openness spezzato in Siemens.Engineering.Base
    + Step7, solo .NET Framework 4.8 x64. Sorgenti in TiaTracker.Worker.Common,
    condivisi con il worker V18 (#if TIA_V21 / TIA_V18).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>tiatracker-worker-v21</AssemblyName>
    <RootNamespace>TiaTracker.Worker</RootNamespace>
    <DefineConstants>$(DefineConstants);TIA_V21</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Override: dotnet build -p:TiaPublicApi="...\PublicAPI\V20\net48" -->
  <PropertyGroup>
    <TiaPublicApi Condition="'$(TiaPublicApi)' == ''">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaPublicApi>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TiaTracker.Worker.Common\**\*.cs" LinkBase="Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaTracker.Contracts\TiaTracker.Contracts.csproj" />
  </ItemGroup>

  <!-- Private=False: le DLL Siemens non si ridistribuiscono, il resolver le trova a runtime. -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaPublicApi)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaPublicApi)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckTiaPublicApi" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(TiaPublicApi)\Siemens.Engineering.Base.dll')"
           Text="DLL Openness V21 non trovate in '$(TiaPublicApi)'. Passare -p:TiaPublicApi=&lt;cartella net48&gt;." />
  </Target>

</Project>
